[Desktop Entry]
Type=Application
Name=Mdow
GenericName=Markdown Viewer
Comment=A quiet markdown viewer
Exec=@BINDIR@/mdow %F
Icon=com.zain.mdow
Terminal=false
Categories=Office;Viewer;
MimeType=text/markdown;text/x-markdown;text/html;
Keywords=markdown;md;mdx;reader;viewer;notes;docs;
StartupNotify=true
