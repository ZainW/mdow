{
  "name": "native",
  "version": "1.14.0",
  "private": true,
  "description": "Mdow Native: the GPUI reader, written in React with gpuix and run on Bun",
  "type": "module",
  "scripts": {
    "start:hot": "bun --hot src/main.tsx",
    "start": "bun src/main.tsx",
    "build": "bun scripts/build.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test",
    "bench": "bun scripts/bench-fixtures.ts && bun scripts/bench.tsx tmp/bench/*.md",
    "bench:files": "bun scripts/bench.tsx"
  },
  "dependencies": {
    "@gpuix/native": "0.10.0",
    "@gpuix/react": "0.10.0",
    "image-size": "^2.0.2",
    "marked": "18.0.9",
    "node-html-parser": "^9.0.4",
    "pele": "^1.6.0",
    "react": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@crabnebula/packager": "0.11.2",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004"
  }
}
