{
  "name": "desktop",
  "version": "1.9.5",
  "private": true,
  "description": "A quiet place to read markdown",
  "author": "Zain Wania",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZainW/mdow.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsgo --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron:perf": "electron-vite build && node perf/electron-render.perf.mjs",
    "test:icons:visual": "VITE_ICON_LAB=true electron-vite build && node perf/icon-visual-compare.mjs",
    "screenshots:web": "electron-vite build && node scripts/capture-website-screenshots.mjs",
    "build:dist": "electron-vite build && electron-builder",
    "publish": "electron-vite build && electron-builder --publish always",
    "postinstall": "node scripts/install-app-deps.mjs && bash scripts/patch-electron-name.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@comark/react": "^0.6.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-query": "^5.102.8",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "comark": "^0.6.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.7",
    "lucide-react": "^1.43.0",
    "mermaid": "^11.17.2",
    "ocache": "^0.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "productName": "Mdow"
}
