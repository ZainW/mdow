{
  "name": "mdow-monorepo",
  "version": "1.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "dev:rune": "bash apps/rune/scripts/run.sh",
    "test:rune": "cargo test --manifest-path apps/rune/Cargo.toml",
    "install:rune": "bash apps/rune/scripts/install.sh",
    "dev:mac": "bash apps/macos/scripts/run.sh",
    "test:mac": "swift test --package-path apps/macos",
    "install:mac": "bash apps/macos/scripts/install.sh",
    "dev:gtk": "cargo run --manifest-path apps/native-linux/Cargo.toml",
    "test:gtk": "cargo test --manifest-path apps/native-linux/Cargo.toml",
    "install:gtk": "bash apps/native-linux/scripts/install.sh",
    "perf:gtk": "bash apps/native-linux/scripts/perf.sh",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "fmt": "turbo fmt",
    "fmt:check": "turbo fmt:check",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  },
  "packageManager": "pnpm@12.18.0"
}
